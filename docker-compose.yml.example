services:
  php:
    image: <your_local_image_here>
    restart: always
    hostname: <hostname>
    ports:
      - "443:443"
    volumes:
      - ./site:/var/www/<domain_name>
      - <apache-certs-volume-here>:/etc/ssl/certs
    depends_on:
      - db
    environment:
      - DOMAIN_NAME=<domain_name>
# Arch linux user
      - APACHE_RUN_USER=#1001
      - APACHE_RUN_GROUP=#985

  db:
    image: <your_local_image_here>
    restart: always
    environment:
      - MARIADB_ROOT_PASSWORD=<root_pass>
      - MARIADB_DATABASE=<db_name>
      - MARIADB_USER=<db_user>
      - MARIADB_PASSWORD=<db_pass>
    volumes:
      - ./backups/databases/mysql:/mysql_dumps
      - <mysql-volume-here>:/var/lib/mysql

  phpmyadmin:
    image: phpmyadmin/phpmyadmin
    restart: always
    environment:
      - PMA_HOST=db
      - PMA_PORT=3306
    ports:
      - "8080:80"
    depends_on:
      - db

volumes:
  <apache-certs-volume-here>:
  <mysql-volume-here>: